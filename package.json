{
  "name": "ag-remote",
  "displayName": "Antigravity Remote",
  "description": "Control your Antigravity agent from your phone: approve or deny commands, send prompts and screenshots, stop runs and get notified, on any network with end-to-end encryption.",
  "version": "0.2.1",
  "publisher": "dr-opensource",
  "icon": "assets/icon.png",
  "author": "Dr. Shubham Kashyap",
  "license": "MIT",
  "pricing": "Free",
  "type": "module",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "antigravity",
    "gemini",
    "remote",
    "phone",
    "companion",
    "agent",
    "approval"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "bin": {
    "ag-remote": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "npx --yes esbuild src/extension/index.ts --bundle --platform=node --target=node20 --format=cjs --external:vscode --outfile=dist/extension.cjs && npx --yes esbuild bin/ag-remote.mjs --bundle --platform=node --target=node20 --format=esm --banner:js=\"#!/usr/bin/env node\" --outfile=dist/cli.mjs",
    "vscode:prepublish": "npm run build",
    "start": "node dist/cli.mjs",
    "start:dev": "node --experimental-strip-types bin/ag-remote.mjs",
    "test": "npm run test:ls && npm run test:multi && npm run test:adapter && npm run test:server && npm run test:hub && npm run test:pwa && npm run test:pairing && npm run test:audit && npm run test:env && npm run test:e2e && npm run test:relay-host",
    "test:adapter": "node --env-file=test/test.env --experimental-strip-types test/test-adapter.ts",
    "test:server": "node --env-file=test/test.env --experimental-strip-types test/test-server.ts",
    "test:hub": "node --env-file=test/test.env --experimental-strip-types test/test-hub-and-cdp.ts",
    "test:pwa": "node --env-file=test/test.env --experimental-strip-types test/test-pwa.ts",
    "test:pairing": "node --env-file=test/test.env --experimental-strip-types test/test-pairing.ts",
    "test:audit": "node --env-file=test/test.env --experimental-strip-types test/test-production-audit.ts",
    "test:env": "node --env-file=test/test.env --experimental-strip-types test/test-environment-sentinel.ts",
    "probe": "node scripts/feasibility-probe.mjs",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies",
    "test:ls": "node --env-file=test/test.env --experimental-strip-types test/test-ls-bridge.ts",
    "test:multi": "node --env-file=test/test.env --experimental-strip-types test/test-multi-window.ts",
    "test:e2e": "node --env-file=test/test.env --experimental-strip-types test/test-e2e.ts",
    "test:relay-host": "node --env-file=test/test.env --experimental-strip-types test/test-relay-host.ts"
  },
  "bugs": {
    "url": "https://github.com/DrOpenSource/AG-Remote/issues"
  },
  "homepage": "https://github.com/DrOpenSource/AG-Remote#readme",
  "devDependencies": {
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "ag-remote.showPairingQr",
        "title": "Antigravity Remote: Show Pairing QR Code",
        "icon": "$(radio-tower)"
      },
      {
        "command": "ag-remote.revokePairings",
        "title": "Antigravity Remote: Revoke All Pairings"
      },
      {
        "command": "ag-remote.managePhones",
        "title": "Antigravity Remote: Manage Paired Phones"
      },
      {
        "command": "ag-remote.restartServer",
        "title": "Antigravity Remote: Restart Server"
      }
    ],
    "configuration": {
      "title": "Antigravity Remote",
      "properties": {
        "agRemote.port": {
          "type": "number",
          "default": 49222,
          "description": "Port on which the local remote server listens."
        },
        "agRemote.host": {
          "type": "string",
          "default": "0.0.0.0",
          "description": "Host address for the server (default: 0.0.0.0 for local Wi-Fi and Tailscale reachability)."
        },
        "agRemote.transport": {
          "type": "string",
          "enum": [
            "both",
            "wifi",
            "relay"
          ],
          "enumDescriptions": [
            "Relay for any network, plus direct Wi-Fi/Tailscale with a PIN",
            "Only direct Wi-Fi/Tailscale with a PIN (nothing goes through the relay)",
            "Only the relay; the local server accepts this PC only"
          ],
          "default": "both",
          "description": "How your phone reaches this PC. The relay is end-to-end encrypted: it forwards messages it cannot read."
        },
        "agRemote.relayUrl": {
          "type": "string",
          "default": "https://remote.taqnik.in",
          "description": "Hosted relay used when transport is \"both\" or \"relay\"."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DrOpenSource/AG-Remote"
  }
}
