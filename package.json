{
  "name": "ag-remote",
  "displayName": "Antigravity Remote Control",
  "description": "Phone Remote Control for Google Antigravity Agent (Approve, Deny, Prompt & Stop from your phone)",
  "version": "0.1.0",
  "publisher": "ag-remote",
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension/index.ts",
  "bin": {
    "ag-remote": "./bin/ag-remote.mjs"
  },
  "scripts": {
    "start": "node --experimental-strip-types bin/ag-remote.mjs",
    "test": "npm run test:adapter && npm run test:server && npm run test:hub && npm run test:pwa && npm run test:pairing && npm run test:audit && npm run test:env",
    "test:adapter": "node --experimental-strip-types test/test-adapter.ts",
    "test:server": "node --experimental-strip-types test/test-server.ts",
    "test:hub": "node --experimental-strip-types test/test-hub-and-cdp.ts",
    "test:pwa": "node --experimental-strip-types test/test-pwa.ts",
    "test:pairing": "node --experimental-strip-types test/test-pairing.ts",
    "test:audit": "node --experimental-strip-types test/test-production-audit.ts",
    "test:env": "node --experimental-strip-types test/test-environment-sentinel.ts",
    "probe": "node scripts/feasibility-probe.mjs",
    "package": "npx --yes @vscode/vsce package --no-dependencies"
  },
  "contributes": {
    "commands": [
      {
        "command": "ag-remote.showPairingQr",
        "title": "Antigravity Remote: Show Pairing QR Code",
        "icon": "$(radio-tower)"
      },
      {
        "command": "ag-remote.revokePairings",
        "title": "Antigravity Remote: Revoke All Pairings"
      },
      {
        "command": "ag-remote.restartServer",
        "title": "Antigravity Remote: Restart Server"
      }
    ],
    "configuration": {
      "title": "Antigravity Remote",
      "properties": {
        "agRemote.port": {
          "type": "number",
          "default": 49222,
          "description": "Port on which the local remote server listens."
        },
        "agRemote.host": {
          "type": "string",
          "default": "0.0.0.0",
          "description": "Host address for the server (default: 0.0.0.0 for local Wi-Fi and Tailscale reachability)."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DrOpenSource/AG-Remote"
  }
}
